rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Products: public read & write for store management
    match /products/{productId} {
      allow read, write: if true;
    }

    // Orders: public create and read
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Reviews: public read and create
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // Repair Requests: public read and create
    match /repair_requests/{requestId} {
      allow read, write: if true;
    }

    // Users & Profiles: allow user profile storage
    match /users/{userId} {
      allow read, write: if true;
    }

    match /profiles/{userId} {
      allow read, write: if true;
    }

    // Custom user uploaded photos
    match /custom_photos/{photoId} {
      allow read, write: if true;
    }

    // Stock Notifications: public create and read
    match /stock_notifications/{notificationId} {
      allow read, write: if true;
    }

    // Site Config: CMS dynamic configuration & banners
    match /site_config/{configId} {
      allow read, write: if true;
    }
  }
}

